SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CONTENT_NAMESPACE=lap
SHOPIFY_ARCHIVE_METAOBJECT_TYPE=archive_entry
SHOPIFY_ABOUT_METAOBJECT_TYPE=about_section
SHOPIFY_LOCATION_METAOBJECT_TYPE=location_entry
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional compatibility alias:
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STOREFRONT_API_VERSION=2024-01
SHOPIFY_ADMIN_API_VERSION=2024-01
SITE_ORIGIN=https://www.lapropagande.net
SHOPIFY_SITE_ORIGIN=https://www.lapropagande.net
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id
NEXT_PUBLIC_CUSTOM_JACKETS_FORM_ENDPOINT=https://formsubmit.co/ajax/lapropagandeparisbey@outlook.com

# Fail-closed ordering switch: only the exact value `true` enables cart/checkout.
# Unset or any other value shows the demo notice. Keep `false` until launch checks pass.
NEXT_PUBLIC_COMMERCE_ENABLED=false
# Dedicated launch-notification form. Server-only; do not use a placeholder live.
LAUNCH_SIGNUP_ENDPOINT=
# Reliable launch list saved privately in the existing Shopify store.
LAUNCH_SIGNUP_STORAGE=shopify
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Server-side inquiry delivery. Use a verified sender on the connected Resend account.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=lapropagandeparisbey@outlook.com
INQUIRY_FORM_ENDPOINT=https://formsubmit.co/ajax/lapropagandeparisbey@outlook.com
# Optional future counter; currently hidden and not requested by the site.
# Server-only credentials. KV_REST_API_* aliases also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opt in only after replacing obsolete Shopify selling-point entries with Fearlove.
SHOPIFY_SELLING_POINTS_SOURCE=approved
